# Majestic — global configuration
# Copy this file to .env and fill in your values.
# Settings here apply to ALL profiles unless overridden in profiles/<name>/.env

# ── LLM Provider (pick ONE to start) ────────────────────────────────────────
# Option A: OpenRouter — access to 200+ models with one key
#           Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Option B: Anthropic directly
# ANTHROPIC_API_KEY=sk-ant-...

# Option C: OpenAI directly
# OPENAI_API_KEY=sk-...

# Option D: Ollama — local models, no API key needed
#           Install: https://ollama.com → run: ollama pull llama3.2 && ollama serve
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Web Search (optional) ────────────────────────────────────────────────────
# Without this, Majestic uses DuckDuckGo (free, no key needed)
# BRAVE_SEARCH_API_KEY=BSA...

# ── Model Routing (optional) ─────────────────────────────────────────────────
# Applies to all profiles. Per-profile persona.yaml model_routing overrides these.
# MAJESTIC_MODEL_REASON=anthropic/claude-sonnet-4-5
# MAJESTIC_MODEL_SIMPLE=meta-llama/llama-3.1-8b-instruct:free
# MAJESTIC_MODEL_CODE=qwen/qwen-2.5-coder-32b-instruct
# MAJESTIC_MODEL_REFLECTION=meta-llama/llama-3.1-8b-instruct:free
