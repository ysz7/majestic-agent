# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files (keep .env.example)
.env
*.env
!.env.example
!**/.env.example

# Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/
sdist/
var/
*.tar.gz
*.zip

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Testing and coverage
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/
.pytest_cache/
pytest.ini

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Jupyter notebooks
.ipynb_checkpoints/

# Logs
*.log
logs/

# Per-profile: databases and generated personal data
profiles/*/data/

# Per-profile: runtime workspace artifacts (outputs, temp scripts, sandboxes)
# workspace/tools/ and skills/ are intentionally kept in git
profiles/*/workspace/output/
profiles/*/workspace/temp/
profiles/*/workspace/.venv/
profiles/*/workspace/node_modules/
profiles/*/workspace/briefings/
profiles/*/workspace/cache/
profiles/*/workspace/downloads/
profiles/*/workspace/exports/
profiles/*/workspace/reports/
profiles/*/workspace/articles/
profiles/*/workspace/news/
profiles/*/workspace/data/

# Stale / misplaced venv at profile root (pain_hunter legacy)
profiles/*/.venv/

# Stale registry folder accidentally created by agent
profiles/data/

# Root data dir — runtime machine-specific (agent registry, logs, tokens)
data/

# Secrets and keys
*.pem
*.key
*.crt
*.p12

# IDE / tooling
.claude/
.idea/
.vscode/
*.swp

# Private
PLAN.md
DEPLOY.md
CLAUDE.md
